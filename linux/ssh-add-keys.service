[Unit]
Description=Add SSH keys to agent
After=ssh-agent.socket
Requires=ssh-agent.socket

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'socket=$$(/usr/bin/systemctl --user show ssh-agent.socket --property=Listen --value); export SSH_AUTH_SOCK="$${socket%% (Stream)}"; for pub in "%h"/.ssh/*.pub; do key="$${pub%%.pub}"; if [ -f "$$key" ]; then /usr/bin/ssh-add "$$key" || exit; fi; done'

[Install]
WantedBy=default.target
